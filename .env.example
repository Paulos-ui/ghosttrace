# Private server-side key. Do not commit .env.local or prefix the key with NEXT_PUBLIC_.
# Obtain a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_private_anthropic_key_here
# Optional. This is a documented Claude API model identifier.
CLAUDE_MODEL=claude-sonnet-4-6
# Open-weight MiniLM is downloaded by the browser on first use. No HF key is needed.
